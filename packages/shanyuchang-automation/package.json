{
  "name": "@lumyne/shanyuchang-automation",
  "version": "0.1.0",
  "description": "山与场滑雪服的商品摄影、详情页与商业图交付 Skill",
  "type": "module",
  "bin": {
    "shanyuchang-automation": "bin/shanyuchang-automation.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --check && node dist/lifecycle/validate-release.mjs",
    "test": "node --test test/*.test.mjs",
    "version": "node build.mjs"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petercjl/cloud-hug-style-transfer.git",
    "directory": "packages/shanyuchang-automation"
  },
  "license": "UNLICENSED",
  "private": true,
  "agentPackage": {
    "kind": "application-skill"
  },
  "skillLifecycle": {
    "skill": "shanyuchang-automation",
    "entry": "bin/shanyuchang-automation.mjs",
    "env": "SHANYUCHANG_AUTOMATION",
    "legacyMarker": ".shanyuchang-automation-managed.json",
    "contract": 2
  }
}
