  "requirements": {
    "node": ">=22",
    "nested_skills": [
      "sealseek-media"
    ],
    "generation": "Required for business planning and generation; maintenance is independent of media service dependencies.",
    "host_capability_skills": {
      "codex": [],
      "sealseek": [],
      "workbuddy": []
    },
    "packages": [
      {
        "name": "@petercjl/sealseek-media-cli",
        "minimum_version": "0.6.1",
        "required": true,
        "missing": "pause",
        "skill": "sealseek-media",
        "source": "CLI skill source --json",
        "contract": "media.generate with image/reference-image/dry-run/task-record/local-artifact; canvas_contract@1 create/image upload/media inspect/explicit batch/verified readback"
      }
    ]
  },
  "authorization": {
    "installation": "Explicit install/update request; preserve existing targets.",
    "generation": "User-authorized generation via sealseek-media-cli only; credits and credentials remain external."
  },
  "compatibility": {
    "codex": {
      "installation": "implemented",
      "generation": "implemented-not-runtime-tested"
    },
    "sealseek": {
      "installation": "implemented",
      "generation": "implemented-not-runtime-tested"
    },
    "workbuddy": {
      "installation": "implemented",
      "generation": "implemented-not-runtime-tested"
    }
  },
  "canvas": {
    "creation": "new-per-generation-request-before-first-submit",
