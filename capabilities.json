{
  "package": "@petercjl/cloud-hug-style-transfer",
  "kind": "application-skill",
  "skill": "cloud-hug-style-transfer",
  "agents": [
    "codex",
    "sealseek",
    "workbuddy"
  ],
  "commands": [
    "version",
    "capabilities",
    "doctor",
    "skill source",
    "skill status",
    "skill install",
    "skill update",
    "update check",
    "update install",
