  "maintenance": {
    "targetPrecedence": [
      "explicit --root",
      "host skills directory environment",
      "Agent home/default"
    ],
    "codexSkillsEnvironment": "CODEX_SKILLS_DIR",
    "defaultUpdateScope": "registered and current-host managed targets; explicit --agent selects one target",
    "receipt": [
      "package",
      "version",
      "source",
      "entry",
      "owner",
      "packageChanged",
      "skills",
      "verified",
      "backup",
      "warnings",
      "timingsMs"
    ],
    "sameVersion": "reconcile managed Skills and metadata; verified no-op when current",
    "metadata": "preserve customization; remove known unsupported api product with backup; unknown invalid schema requires reconciliation"
  },
  "automaticUpdates": {
    "enabledByDefault": true,
    "defaultMode": "notify",
    "modes": [
      "off",
      "notify",
      "auto"
    ],
    "installation": "explicit-standing-authorization",
    "trigger": "doctor at business-task entry; update auto",
    "intervalHours": 24,
    "timeoutMs": 2000,
    "offlineRetryMs": 300000,
    "channel": "latest",
    "compatibility": "same major; same minor for 0.x; stable versions only",
    "configuration": "update policy; installation-scoped state outside package",
    "disable": "update policy --mode off --yes or CLOUD_HUG_AUTO_UPDATE=0",
    "recovery": "existing update install backup, Skill sync, ownership/edit guards and rollback",
    "continuation": "restart CLI after package replacement; reload canonical Skill when changed"
  }
