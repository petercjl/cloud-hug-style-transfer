    "layout": "source-left-result-right; rows-top-to-bottom",
    "column_width": 480,
    "horizontal_gap": 24,
    "vertical_gap": 32,
    "archive": "none during generation; explicit pair batch after each success",
    "planner": "canvas row --input JSON_FILE --json",
    "recovery": "same canvas/task/row IDs; inspect before replay"
  },
