{
  "schema": "portable-skill-capabilities",
  "schema_version": "1.0.0",
  "target_platforms": [
    "generic"
  ],
  "capabilities": [
    {
      "id": "media.image.inspect",
      "purpose": "实际查看源图、品牌参考和生成结果",
      "required": true,
      "required_features": [
        "local-image",
        "visual-inspection"
      ],
      "input_fields": [
        "images",
        "instructions"
      ],
      "output_fields": [
        "ok",
        "artifacts",
        "metadata",
        "warnings"
      ],
      "side_effects": {
        "external_mutation": false,
        "may_cost_money": false,
        "authorization": "Current user task scope; host confirmation rules and selected provider apply."
      },
      "errors": [
        "CAPABILITY_UNAVAILABLE",
        "FEATURE_UNSUPPORTED",
        "AUTH_REQUIRED",
        "PERMISSION_REQUIRED",
        "PROVIDER_FAILURE",
        "OUTPUT_CONTRACT_FAILED",
        "DEPENDENCY_MISSING",
        "DEPENDENCY_INVALID",
        "DEPENDENCY_INCOMPATIBLE"
      ]
    },
    {
      "id": "media.image.edit",
      "purpose": "按原图保持身份与商品事实执行风格转换",
      "required": true,
      "required_features": [
        "multiple-references",
        "reference-image-edit",
        "local-reference-input",
        "viewable-output"
      ],
      "input_fields": [
        "images",
        "instructions"
      ],
      "output_fields": [
        "ok",
        "artifacts",
        "metadata",
        "warnings"
      ],
      "side_effects": {
        "external_mutation": true,
        "may_cost_money": true,
        "authorization": "Current user task scope; host confirmation rules and selected provider apply."
      },
      "errors": [
        "CAPABILITY_UNAVAILABLE",
        "FEATURE_UNSUPPORTED",
        "AUTH_REQUIRED",
        "PERMISSION_REQUIRED",
        "PROVIDER_FAILURE",
        "OUTPUT_CONTRACT_FAILED",
        "DEPENDENCY_MISSING",
        "DEPENDENCY_INVALID",
        "DEPENDENCY_INCOMPATIBLE"
      ],
      "provider": "@petercjl/sealseek-media-cli"
    },
    {
      "id": "media.canvas.compare",
      "purpose": "首张生图前新建命名画板，逐张成对插入左原图右成图并验证紧凑逐行布局",
      "required": true,
      "required_features": [
        "new-canvas",
        "source-upload",
        "actual-dimensions",
        "explicit-placement",
        "idempotent-pair-import",
        "verified-save"
      ],
      "input_fields": [
        "title",
        "canvas_id",
        "images",
        "row_layout",
        "authorization"
      ],
      "output_fields": [
        "ok",
        "artifacts",
        "metadata",
        "canvas_id",
        "canvas_url",
        "verified",
        "warnings"
      ],
      "side_effects": {
        "external_mutation": true,
        "may_cost_money": false,
        "authorization": "Authorized image task includes its new canvas, source uploads and result archival; generation remains separately authorized."
      },
      "errors": [
        "DEPENDENCY_MISSING",
        "DEPENDENCY_INCOMPATIBLE",
        "AUTH_REQUIRED",
        "CAPABILITY_UNAVAILABLE",
        "FEATURE_UNSUPPORTED",
        "SUBMISSION_UNCERTAIN",
        "IDEMPOTENCY_CONFLICT",
        "OUTPUT_CONTRACT_FAILED"
      ]
    }
  ],
  "dependencies": [
    {
      "package": "@petercjl/sealseek-media-cli",
      "minimum_version": "0.6.1",
      "skill": "sealseek-media",
      "required": true,
      "preflight": "cloud-hug-style-transfer doctor --json",
      "on_missing": "pause-entire-task"
    }
  ],
  "package_version": "0.5.2",
  "installationLifecycle": {
    "agentNeutral": true,
    "skillRequired": true,
    "updateRequiresSkillSync": true,
    "required_components": [
      "cli",
      "skill",
      "runtime"
    ],
    "installGuide": "INSTALL.md",
    "updateGuide": "UPDATE.md",
    "explicitTargetRequired": true,
    "hostDiscoveryVerification": true,
    "physicalCopies": true,
    "isolatedRuntime": true,
    "sharedLinks": false,
    "postBumpIdentityValidation": true,
    "install": "Resolve own directory; skill install --agent AGENT --path EXACT_SKILL_DIR --json",
    "update": "Resolve selected target first; update install --yes --path EXACT_SKILL_DIR --json",
    "verification": "Local runtime version, managed hashes, then host-native discovery",
    "target_scope": "selected current Agent only",
    "targetRequired": true,
    "hostRegistrationRequired": true,
    "installationMode": "copy",
    "sharedLinksAllowed": false,
    "isolatedRuntimeRequired": true
  },
  "automaticUpdates": {
    "enabledByDefault": true,
    "defaultMode": "notify",
    "intervalHours": 24,
    "timeoutMs": 2000,
    "trigger": "ordinary task entry; excludes help/version/source/task polling",
    "configuration": "update policy --mode off|notify|auto --yes --path EXACT_SKILL_DIR",
    "disable": "CLOUD_HUG_AUTO_UPDATE=0",
    "installation": "explicit standing authorization; compatible stable version only",
    "recovery": "update operation and resume reuse verified candidate"
  },
